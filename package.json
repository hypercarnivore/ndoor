{
  "name": "ndoor",
  "version": "0.2.0",
  "description": "Neighborhood analytics for Nextdoor: community health, sentiment, and business insight from a private local graph",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ndoor": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && vite build --config web/vite.config.ts",
    "dev": "tsx src/index.ts",
    "ndoor": "pnpm run build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check . && tsc --noEmit -p web",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "binary": "bun build --compile --minify-syntax --minify-whitespace src/index.ts --outfile ndoor",
    "build:cli": "tsc",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@ladybugdb/core": "0.21.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@typesafe-ai/sdk": "0.6.0",
    "commander": "^14.0.2",
    "json5": "^2.2.3",
    "kleur": "^4.1.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.8",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-3d": "1.29.2",
    "recharts": "3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
